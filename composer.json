{
    "name": "tomaj/omnipay-viamo",
    "description": "Viamo mobile payments gateway for the Omnipay payment processing library",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "viamo",
        "gateway",
        "merchant",
        "omnipay",
        "pay",
        "payment",
        "qr-code",
        "slovakia"
    ],
    "authors": [
        {
            "name": "Tomas Majer",
            "email": "tomasmajer@gmail.com",
            "homepage": "http://www.tomaj.sk/"
        }
    ],
    "homepage": "https://tomaj.github.io/omnipay-viamo/",
    "support": {
        "issues": "https://github.com/tomaj/omnipay-viamo/issues",
        "source": "https://github.com/tomaj/omnipay-viamo",
        "docs": "https://tomaj.github.io/omnipay-viamo/",
        "security": "https://github.com/tomaj/omnipay-viamo/security/policy"
    },
    "require": {
        "php": "^8.4",
        "ext-gd": "*",
        "ext-hash": "*",
        "ext-openssl": "*",
        "endroid/qr-code": "^6.0",
        "nyholm/psr7": "^1.8",
        "omnipay/common": "^3.5",
        "psr/http-client": "^1.0",
        "symfony/http-client": "^7.4 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "guzzlehttp/psr7": "^2.12.3 || ^3.0.0",
        "infection/infection": "^0.35",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0.5",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.2",
        "rector/rector": "^2.8"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Omnipay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipay\\Viamo\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-http/discovery": false
        },
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@phpcs",
            "@phpstan",
            "@rector",
            "@test"
        ],
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-clover build/logs/clover.xml --coverage-html build/coverage"
        ],
        "cs-fix": "php-cs-fixer fix",
        "infection": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --threads=max"
        ],
        "phpcs": "php-cs-fixer fix --dry-run --diff --verbose",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpunit": [
            "@putenv XDEBUG_MODE=off",
            "phpunit --no-coverage"
        ],
        "rector": "rector --dry-run",
        "rector-fix": "rector",
        "test": "@phpunit"
    },
    "scripts-descriptions": {
        "check": "Run code style, static analysis, Rector and tests",
        "coverage": "Run the tests with Clover and HTML coverage reports in build/",
        "cs-fix": "Fix the code style with PHP-CS-Fixer",
        "infection": "Run mutation testing with Infection",
        "phpcs": "Check the code style with PHP-CS-Fixer (dry run)",
        "phpstan": "Run PHPStan static analysis",
        "phpunit": "Run the PHPUnit tests without coverage",
        "rector": "Show the changes Rector would make (dry run)",
        "rector-fix": "Apply the Rector changes",
        "test": "Run the test suite"
    }
}
