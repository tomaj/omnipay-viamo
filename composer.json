{
    "name": "tomaj/omnipay-viamo",
    "type": "library",
    "description": "Viamo driver for the Omnipay payment processing library",
    "keywords": [
        "viamo",
        "gateway",
        "merchant",
        "omnipay",
        "pay",
        "payment"
    ],
    "homepage": "https://github.com/tomaj/omnipay-viamo",
    "license": "MIT",
    "authors": [
        {
            "name": "Tomas Majer",
            "email": "tomasmajer@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Omnipay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipay\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "ext-hash": "*",
        "ext-openssl": "*",
        "endroid/qr-code": "^6.0",
        "omnipay/common": "^3.3",
        "symfony/http-client": "^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "guzzlehttp/psr7": "^2.12.3",
        "omnipay/tests": "^4.2",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0.5",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "check": [
            "@phpcs",
            "@phpstan",
            "@test"
        ],
        "cs-fix": "php-cs-fixer fix",
        "phpcs": "php-cs-fixer fix --dry-run --diff --verbose",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpunit": [
            "@putenv XDEBUG_MODE=off",
            "phpunit --no-coverage"
        ],
        "test": "@phpunit"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    }
}
